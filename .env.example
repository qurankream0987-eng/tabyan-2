# Copy to .env and fill in the empty values.
DATABASE_URL=
NABR_QRC_API_KEY=
NABR_QRC_DRY_RUN="true"
NABR_QRC_ENABLED="false"
NABR_QRC_SHADOW_MODE="true"
NVIDIA_API_KEY=
OPENAI_API_KEY=
PGDATABASE="tabyan_dev"
PGHOST="localhost"
PGPASSWORD=
PGPORT="5433"
PGUSER="postgres"
PRIVATE_OBJECT_DIR="/replit-objstore-58df0ee3-6dde-4522-a8e4-d9f4c49777f6/.private"
PUBLIC_OBJECT_SEARCH_PATHS="/replit-objstore-58df0ee3-6dde-4522-a8e4-d9f4c49777f6/public"
SESSION_SECRET=
SPEECHMATICS_API_KEY=
TABYAN_AI_ASR_PROVIDER="tarteel"
TABYAN_AI_ENABLED="true"
TABYAN_AI_LIVE_TRACKING_ENABLED="true"
TABYAN_AI_TARTEEL_TRIAL_ENABLED="true"
TABYAN_AI_TRANSCRIPTION_ENABLED="true"
# TABYAN_AI_ASR_PROVIDER="tilawi" runs the in-process model fetched by tools/scripts/fetch-asr-model.mjs
# Relative to apps/api, where the API runs.
TABYAN_TILAWI_MODEL_DIR="models/tilawi"

# Local S3 (SeaweedFS in .local-s3, port 9000). Swap these for the real Railway bucket later.
TABYAN_OBJECT_STORAGE_PROVIDER=railway
RAILWAY_BUCKET_DISPLAY_NAME=tabyan-local
RAILWAY_BUCKET_S3_NAME=tabyan-local
RAILWAY_DEPLOYMENT_REGION=local
RAILWAY_BUCKET_SIGNING_REGION=us-east-1
RAILWAY_BUCKET_URL_STYLE=path
RAILWAY_BUCKET_ENDPOINT=http://localhost:9000
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_PRIVATE_OBJECT_PREFIX=private
RAILWAY_PUBLIC_OBJECT_PREFIXES=public
