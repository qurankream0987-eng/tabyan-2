{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "tibyanquran.com",
        "EXPO_PUBLIC_PRODUCTION_DOMAIN": "tibyanquran.com",
        "EXPO_PUBLIC_WS_ORIGIN": "wss://tibyanquran.com"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "tibyanquran.com",
        "EXPO_PUBLIC_PRODUCTION_DOMAIN": "tibyanquran.com",
        "EXPO_PUBLIC_WS_ORIGIN": "wss://tibyanquran.com"
      }
    }
  }
}