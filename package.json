{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm run verify:mushaf && pnpm -r --if-present run build",
    "verify:contracts": "node scripts/verify-contract-baseline.mjs",
    "verify:design-tokens": "node scripts/verify-design-tokens.mjs",
    "verify:product-registry": "node scripts/verify-product-registry.mjs",
    "verify:home-navigation-parity": "node scripts/verify-home-navigation-parity.mjs",
    "verify:screen-parity": "node scripts/verify-screen-parity.mjs",
    "app-store:preflight": "node scripts/app-store-preflight-cleanup.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "verify:mushaf": "node scripts/verify-mushaf.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "pnpm": {
    "packageExtensions": {
      "react-native-audio-api@*": {
        "dependencies": {
          "@expo/config-plugins": "54.0.5"
        }
      }
    }
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
